PORT=3000

# Banco: em hospedagem gerenciada (Neon, Railway, Render) preencha DATABASE_URL
# e ignore as PG* abaixo. Localmente, o contrario.
#
# O deploy usa o Neon. A string sai em Dashboard > Connect, no formato
# postgresql://USUARIO:SENHA@ep-....neon.tech/BANCO?sslmode=verify-full
# Pegue a variante com "-pooler" no host: o free tier do Render derruba e
# reabre conexoes a cada wake-up, e o pooler absorve isso.
#
# Prefira sslmode=verify-full a sslmode=require. Hoje o pg trata os dois como
# verificacao completa, mas no pg 9 o "require" passa a aceitar certificado
# nao verificado, e a mudanca seria silenciosa.
# DATABASE_URL=
#
# So vale para URL SEM sslmode. Se a URL traz sslmode, ele manda e esta linha
# nao faz nada.
# DATABASE_SSL=true

PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

# Numero de proxies a confiar no X-Forwarded-For. 0 local, 1 atras do Render.
# Sem isto, o rate limit enxerga todos os visitantes como um unico IP.
TRUST_PROXY=0

# false desliga a finalizacao de compra: o servidor recusa /pagamentos/criar e
# a loja exibe aviso de demonstracao. Usado no deploy publico.
CHECKOUT_HABILITADO=true

# Obrigatorio, minimo de 32 caracteres. O servidor nao inicia sem isso.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Segredo da assinatura do webhook, no painel do Mercado Pago em
# Suas integracoes > Webhooks > Configurar notificacoes.
# Vazio = notificacoes aceitas sem verificar assinatura (registra aviso no log).
MP_WEBHOOK_SECRET=

# Login com Google. So o Client ID: nao e segredo e nao ha client secret, porque
# o servidor confere o token no endpoint publico tokeninfo da Google.
# Crie em console.cloud.google.com > APIs e servicos > Credenciais > ID do
# cliente OAuth (Aplicativo da Web). Em "Origens JavaScript autorizadas",
# liste http://localhost:3000 e a URL do deploy.
# Vazio = o botao "Entrar com Google" nao aparece.
GOOGLE_CLIENT_ID=

# Envio de e-mail: confirmacao de cadastro e recuperacao de senha. Sem SMTP,
# ninguem cria conta com senha (o cadastro exige confirmar o e-mail por link);
# o login com Google continua funcionando.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=