PORT=3000

# Banco: em hospedagem gerenciada (Render, Railway, Neon) preencha DATABASE_URL
# e ignore as PG* abaixo. Localmente, o contrario.
# DATABASE_URL=
# DATABASE_SSL=false     # a URL interna do Render dispensa TLS

PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

# Numero de proxies a confiar no X-Forwarded-For. 0 local, 1 atras do Render.
# Sem isto, o rate limit enxerga todos os visitantes como um unico IP.
TRUST_PROXY=0

# false desliga a finalizacao de compra: o servidor recusa /pagamentos/criar e
# a loja exibe aviso de demonstracao. Usado no deploy publico.
CHECKOUT_HABILITADO=true

# Obrigatorio, minimo de 32 caracteres. O servidor nao inicia sem isso.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Segredo da assinatura do webhook, no painel do Mercado Pago em
# Suas integracoes > Webhooks > Configurar notificacoes.
# Vazio = notificacoes aceitas sem verificar assinatura (registra aviso no log).
MP_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=